
"use strict";

document.addEventListener("DOMContentLoaded", () => {
  const $ = (id) => document.getElementById(id);

  // MENU PARA CELULAR
  const menuBotao = $("menuBotao");
  const menu = $("menu");

  if (menuBotao && menu) {
    menuBotao.addEventListener("click", () => {
      const aberto = menu.classList.toggle("aberto");
      menuBotao.setAttribute("aria-expanded", String(aberto));
      menuBotao.setAttribute(
        "aria-label",
        aberto ? "Fechar menu" : "Abrir menu"
      );
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.remove("aberto");
        menuBotao.setAttribute("aria-expanded", "false");
      });
    });
  }

  // SIMULADOR DA PISCINA
  const controlesPiscina = ["sol", "cobertura", "aquecimento"];

  function atualizarPiscina() {
    const sol = Number($("sol").value);
    const cobertura = Number($("cobertura").value);
    const aquecimento = Number($("aquecimento").value);

    $("solValor").textContent = sol + "%";
    $("coberturaValor").textContent = cobertura + "%";
    $("aquecimentoValor").textContent = aquecimento + "%";

    $("energiaSolar").textContent = sol + "%";
    $("calorConservado").textContent = cobertura + "%";
    $("energiaAuxiliar").textContent = aquecimento + "%";

    // Modelo didático ilustrativo, não uma previsão física real.
    const temperatura =
      18 +
      sol * 0.10 +
      cobertura * 0.035 +
      aquecimento * 0.055;

    $("temperaturaPiscina").textContent =
      temperatura.toLocaleString("pt-BR", {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1
      }) + " °C";

    let mensagem;

    if (sol < 25 && aquecimento < 25) {
      mensagem = "Pouca energia disponível: o aquecimento será limitado.";
    } else if (cobertura >= 70) {
      mensagem = "Boa conservação de calor no modelo simulado!";
    } else if (sol >= 70) {
      mensagem = "A contribuição solar está elevada.";
    } else {
      mensagem = "Ajuste os controles e compare os resultados.";
    }

    $("mensagemPiscina").textContent = mensagem;
    desenharGraficoSolar();
  }

  controlesPiscina.forEach((id) => {
    $(id).addEventListener("input", atualizarPiscina);
  });

  $("resetPiscina").addEventListener("click", () => {
    $("sol").value = 70;
    $("cobertura").value = 50;
    $("aquecimento").value = 20;
    atualizarPiscina();
  });

  // DIMENSIONAMENTO DOS GRÁFICOS
  function prepararCanvas(canvas) {
    const largura = Math.max(260, canvas.clientWidth);
    const altura = Math.max(200, canvas.clientHeight);
    const escala = Math.min(window.devicePixelRatio || 1, 2);

    canvas.width = Math.round(largura * escala);
    canvas.height = Math.round(altura * escala);

    const ctx = canvas.getContext("2d");
    ctx.setTransform(escala, 0, 0, escala, 0, 0);

    return { ctx, largura, altura };
  }

  function texto(ctx, valor, x, y, cor = "#b9c5e3", tamanho = 11) {
    ctx.fillStyle = cor;
    ctx.font = `${tamanho}px Arial`;
    ctx.fillText(valor, x, y);
  }

  // GRÁFICO DA RADIAÇÃO DO CORPO NEGRO
  function desenharGraficoCorpoNegro() {
    const canvas = $("graficoCorpoNegro");
    if (!canvas) return;

    const { ctx, largura: w, altura: h } = prepararCanvas(canvas);
    const esquerda = 43;
    const direita = 12;
    const topo = 18;
    const baixo = 37;
    const gw = w - esquerda - direita;
    const gh = h - topo - baixo;

    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = "#0b142b";
    ctx.fillRect(0, 0, w, h);

    ctx.strokeStyle = "rgba(185,197,227,.13)";
    ctx.lineWidth = 1;

    for (let i = 0; i <= 4; i++) {
      const y = topo + gh * i / 4;
      ctx.beginPath();
      ctx.moveTo(esquerda, y);
      ctx.lineTo(w - direita, y);
      ctx.stroke();
    }

    for (let i = 0; i <= 4; i++) {
      const x = esquerda + gw * i / 4;
      ctx.beginPath();
      ctx.moveTo(x, topo);
      ctx.lineTo(x, h - baixo);
      ctx.stroke();
    }

    texto(ctx, "Intensidade relativa", 8, 13, "#b9c5e3", 10);
    texto(ctx, "Comprimento de onda (nm)", w / 2 - 70, h - 9, "#b9c5e3", 10);

    [200, 400, 600, 800, 1000].forEach((v, i) => {
      texto(ctx, String(v), esquerda + gw * i / 4 - 10, h - 21);
    });

    const T = Number($("temperaturaCorpo").value);
    $("temperaturaCorpoValor").textContent = T + " K";

    // Lei de Planck: intensidade espectral relativa.
    // Lambda é medido em metros.
    function planck(lambdaNm, temperatura) {
      const lambda = lambdaNm * 1e-9;
      const c2 = 1.4387769e-2;
      const expoente = c2 / (lambda * temperatura);

      if (expoente > 700) return 0;

      return 1 / (
        Math.pow(lambda, 5) * Math.expm1(expoente)
      );
    }

    const temperaturas = [
      { valor: 3000, cor: "#a78bfa" },
      { valor: T, cor: "#56e5f2" },
      { valor: 5500, cor: "#7cf7c4" }
    ];

    const curvas = temperaturas.map((serie) => {
      const pontos = [];

      for (let lambda = 200; lambda <= 1000; lambda += 4) {
        pontos.push({
          lambda,
          intensidade: planck(lambda, serie.valor)
        });
      }

      const maximo = Math.max(...pontos.map(p => p.intensidade)) || 1;

      return {
        ...serie,
        pontos: pontos.map(p => ({
          lambda: p.lambda,
          intensidade: p.intensidade / maximo
        }))
      };
    });

    curvas.forEach((serie) => {
      ctx.beginPath();
      ctx.strokeStyle = serie.cor;
      ctx.lineWidth = serie.valor === T ? 2.8 : 1.6;

      serie.pontos.forEach((p, i) => {
        const x = esquerda + ((p.lambda - 200) / 800) * gw;
        const y = topo + gh * (1 - p.intensidade);

        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });

      ctx.stroke();
    });

    texto(ctx, "3000 K", esquerda + 8, topo + 15, "#a78bfa", 10);
    texto(ctx, T + " K", esquerda + 75, topo + 15, "#56e5f2", 10);
    texto(ctx, "5500 K", esquerda + 135, topo + 15, "#7cf7c4", 10);
  }

  $("temperaturaCorpo").addEventListener(
    "input",
    desenharGraficoCorpoNegro
  );

  // GRÁFICO DA CONTRIBUIÇÃO SOLAR
  function desenharGraficoSolar() {
    const canvas = $("graficoSolar");
    if (!canvas) return;

    const { ctx, largura: w, altura: h } = prepararCanvas(canvas);
    const esquerda = 42;
    const direita = 14;
    const topo = 22;
    const baixo = 36;
    const gw = w - esquerda - direita;
    const gh = h - topo - baixo;

    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = "#0b142b";
    ctx.fillRect(0, 0, w, h);

    ctx.strokeStyle = "rgba(185,197,227,.13)";

    for (let i = 0; i <= 4; i++) {
      const y = topo + gh * i / 4;
      ctx.beginPath();
      ctx.moveTo(esquerda, y);
      ctx.lineTo(w - direita, y);
      ctx.stroke();

      texto(ctx, String(100 - i * 25), 7, y + 4);
    }

    for (let i = 0; i <= 4; i++) {
      const x = esquerda + gw * i / 4;
      ctx.beginPath();
      ctx.moveTo(x, topo);
      ctx.lineTo(x, h - baixo);
      ctx.stroke();

      texto(ctx, String(i * 25), x - 7, h - 16);
    }

    texto(ctx, "Contribuição (%)", 8, 13, "#b9c5e3", 10);
    texto(ctx, "Intensidade solar (%)", w / 2 - 63, h - 3, "#b9c5e3", 10);

    const solAtual = Number($("sol").value);
    const pontos = [];

    for (let x = 0; x <= 100; x += 2) {
      pontos.push({
        x,
        y: x * 0.8
      });
    }

    ctx.beginPath();
    ctx.strokeStyle = "#a78bfa";
    ctx.lineWidth = 2.5;

    pontos.forEach((p, i) => {
      const x = esquerda + (p.x / 100) * gw;
      const y = topo + (1 - p.y / 100) * gh;

      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });

    ctx.stroke();

    const marcadorX = esquerda + solAtual / 100 * gw;
    const marcadorY = topo + (1 - solAtual * 0.8 / 100) * gh;

    ctx.beginPath();
    ctx.arc(marcadorX, marcadorY, 5, 0, Math.PI * 2);
    ctx.fillStyle = "#56e5f2";
    ctx.fill();

    texto(
      ctx,
      `Sol atual: ${solAtual}%`,
      Math.max(esquerda + 5, Math.min(marcadorX - 35, w - 100)),
      Math.max(topo + 15, marcadorY - 12),
      "#56e5f2",
      10
    );
  }

  // SENSORES E TOMADA DE DECISÃO
  const sensores = ["temperaturaSensor", "luzSensor", "nivelSensor"];

  function atualizarDecisao() {
    const temperatura = Number($("temperaturaSensor").value);
    const luz = Number($("luzSensor").value);
    const nivel = Number($("nivelSensor").value);

    $("temperaturaSensorValor").textContent = temperatura + " °C";
    $("luzSensorValor").textContent = luz + "%";
    $("nivelSensorValor").textContent = nivel + "%";

    let titulo = "Sistema em monitoramento";
    let decisao = "Condições dentro dos limites configurados.";
    let status = "● Sistema ativo";

    if (nivel < 20) {
      titulo = "Nível de água baixo";
      decisao = "O sensor detectou nível reduzido. Recomenda-se verificar o nível antes de acionar equipamentos.";
      status = "● Atenção ao nível";
    } else if (temperatura >= 38) {
      titulo = "Temperatura elevada";
      decisao = "O sistema recomenda verificar a temperatura e reduzir o aquecimento, se necessário.";
      status = "● Atenção à temperatura";
    } else if (luz < 20) {
      titulo = "Pouca luminosidade";
      decisao = "A contribuição solar pode estar reduzida. O sistema pode avaliar outras fontes de energia.";
      status = "● Pouca luz disponível";
    } else {
      titulo = "Condições monitoradas";
      decisao = "Os sensores estão enviando dados. O sistema não identificou os alertas configurados.";
      status = "● Monitoramento ativo";
    }

    $("tituloDecisao").textContent = titulo;
    $("decisao").textContent = decisao;
    $("statusTexto").textContent = status;

    const registro = $("logSistema");
    const linha = document.createElement("li");
    linha.textContent =
      `${temperatura} °C · luz ${luz}% · água ${nivel}%`;

    registro.prepend(linha);

    while (registro.children.length > 4) {
      registro.lastElementChild.remove();
    }
  }

  sensores.forEach((id) => {
    $(id).addEventListener("input", atualizarDecisao);
  });

  // QUIZ
  const perguntas = [
    {
      pergunta: "O que determina a energia de um fóton?",
      opcoes: [
        "Apenas a distância percorrida pela luz",
        "A frequência da radiação",
        "A cor do objeto que recebe a luz",
        "A massa do fóton"
      ],
      correta: 1,
      explicacao: "A energia do fóton é dada por E = h · f: ela é proporcional à frequência."
    },
    {
      pergunta: "O que acontece quando a temperatura de um corpo negro aumenta?",
      opcoes: [
        "Ele deixa de emitir radiação",
        "A radiação sempre desaparece",
        "O pico da emissão se desloca para comprimentos de onda menores",
        "Sua temperatura diminui automaticamente"
      ],
      correta: 2,
      explicacao: "Pela lei de Wien, temperaturas maiores correspondem a picos em comprimentos de onda menores."
    },
    {
      pergunta: "Qual é a principal função de uma cobertura térmica na piscina?",
      opcoes: [
        "Aumentar a gravidade",
        "Reduzir a perda de calor",
        "Produzir luz visível",
        "Transformar água em eletricidade"
      ],
      correta: 1,
      explicacao: "A cobertura ajuda a reduzir perdas de calor, principalmente as associadas à evaporação."
    },
    {
      pergunta: "Qual é a função de um sensor em um sistema robótico?",
      opcoes: [
        "Coletar informações do ambiente",
        "Garantir energia infinita",
        "Substituir todos os motores",
        "Impedir qualquer falha"
      ],
      correta: 0,
      explicacao: "Sensores coletam dados que podem ser interpretados pelo sistema de controle."
    },
    {
      pergunta: "Qual tecnologia converte luz solar em energia elétrica?",
      opcoes: [
        "Cobertura térmica comum",
        "Termômetro de mercúrio",
        "Painel fotovoltaico",
        "Sensor de nível"
      ],
      correta: 2,
      explicacao: "Células fotovoltaicas convertem parte da energia da luz em energia elétrica."
    }
  ];

  let indice = 0;
  let pontos = 0;
  let respondeu = false;

  function mostrarPergunta() {
    respondeu = false;

    const atual = perguntas[indice];

    $("quizContador").textContent =
      `Pergunta ${indice + 1} de ${perguntas.length}`;

    $("quizPontos").textContent = `Pontos: ${pontos}`;
    $("quizBarra").style.width =
      `${(indice / perguntas.length) * 100}%`;

    $("quizPergunta").textContent = atual.pergunta;
    $("feedbackQuiz").textContent = "";
    $("quizProximo").disabled = true;
    $("quizProximo").textContent =
      indice === perguntas.length - 1
        ? "Ver resultado →"
        : "Próxima pergunta →";

    const opcoes = $("opcoesQuiz");
    opcoes.replaceChildren();

    atual.opcoes.forEach((opcao, i) => {
      const botao = document.createElement("button");
      botao.type = "button";
      botao.className = "opcao";
      botao.textContent = `${String.fromCharCode(65 + i)}. ${opcao}`;

      botao.addEventListener("click", () => {
        if (respondeu) return;
        respondeu = true;

        const botoes = opcoes.querySelectorAll("button");
        botoes.forEach((b) => {
          b.disabled = true;
        });

        if (i === atual.correta) {
          pontos++;
          botao.classList.add("certa");
          $("feedbackQuiz").textContent = "✓ Acertou! " + atual.explicacao;
        } else {
          botao.classList.add("errada");
          botoes[atual.correta].classList.add("certa");
          $("feedbackQuiz").textContent = "Ainda não! " + atual.explicacao;
        }

        $("quizPontos").textContent = `Pontos: ${pontos}`;
        $("quizBarra").style.width =
          `${((indice + 1) / perguntas.length) * 100}%`;

        $("quizProximo").disabled = false;
      });

      opcoes.appendChild(botao);
    });
  }

  $("quizProximo").addEventListener("click", () => {
    if (!respondeu) return;

    indice++;

    if (indice >= perguntas.length) {
      $("quizContador").textContent = "Desafio concluído!";
      $("quizPergunta").textContent =
        `Você acertou ${pontos} de ${perguntas.length} perguntas!`;

      $("quizBarra").style.width = "100%";
      $("opcoesQuiz").replaceChildren();
      $("feedbackQuiz").textContent =
        pontos === perguntas.length
          ? "Perfeito! Você dominou todos os desafios. ✨"
          : "Muito bem por chegar até aqui! Revise os conceitos e tente novamente.";

      $("quizProximo").textContent = "Jogar novamente ↻";
      $("quizProximo").disabled = false;
      respondeu = true;
      return;
    }

    mostrarPergunta();
  });

  // O botão vira opção de reiniciar após o fim.
  $("quizProximo").addEventListener("click", () => {
    if (
      indice >= perguntas.length &&
      respondeu
    ) {
      indice = 0;
      pontos = 0;
      mostrarPergunta();
    }
  });

  // INICIALIZAÇÃO
  atualizarPiscina();
  atualizarDecisao();
  mostrarPergunta();

  // Atualiza o tamanho dos gráficos ao redimensionar a janela.
  let temporizadorRedesenho;

  window.addEventListener("resize", () => {
    clearTimeout(temporizadorRedesenho);

    temporizadorRedesenho = setTimeout(() => {
      desenharGraficoCorpoNegro();
      desenharGraficoSolar();
    }, 120);
  });

  desenharGraficoCorpoNegro();
  desenharGraficoSolar();
});
