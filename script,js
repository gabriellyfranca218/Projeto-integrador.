/* 1. MENU PARA CELULAR */

const menuToggle = document.getElementById("menuToggle");
const menu = document.getElementById("menu");

if (menuToggle && menu) {
  menuToggle.addEventListener("click", () => {
    const aberto = menu.classList.toggle("aberto");

    menuToggle.setAttribute("aria-expanded", String(aberto));
    menuToggle.textContent = aberto ? "Fechar menu ✕" : "☰ Menu";
  });

  menu.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.remove("aberto");
      menuToggle.setAttribute("aria-expanded", "false");
      menuToggle.textContent = "☰ Menu";
    });
  });
}


/* 2. ACESSIBILIDADE */

const botaoContraste = document.getElementById("contraste");
const botaoFonte = document.getElementById("fonte");
const botaoAumentar = document.getElementById("aumentar");
const botaoDiminuir = document.getElementById("diminuir");

let tamanhoFonte = 16;

if (botaoContraste) {
  botaoContraste.addEventListener("click", () => {
    const ativado = document.body.classList.toggle("alto-contraste");
    botaoContraste.setAttribute("aria-pressed", String(ativado));
  });
}

if (botaoFonte) {
  botaoFonte.addEventListener("click", () => {
    const ativada = document.body.classList.toggle("fonte-leitura");
    botaoFonte.setAttribute("aria-pressed", String(ativada));
  });
}

function atualizarFonte() {
  document.documentElement.style.setProperty("--fonte", `${tamanhoFonte}px`);
}

if (botaoAumentar) {
  botaoAumentar.addEventListener("click", () => {
    tamanhoFonte = Math.min(tamanhoFonte + 2, 26);
    atualizarFonte();
  });
}

if (botaoDiminuir) {
  botaoDiminuir.addEventListener("click", () => {
    tamanhoFonte = Math.max(tamanhoFonte - 2, 12);
    atualizarFonte();
  });
}


/* 3. SIMULADOR DE ONDAS ELETROMAGNÉTICAS */

const seletorOnda = document.getElementById("onda");
const ondaVisual = document.getElementById("ondaVisual");
const ondaTitulo = document.getElementById("ondaTitulo");
const ondaTexto = document.getElementById("ondaTexto");
const ondaDado = document.getElementById("ondaDado");

const ondas = {
  radio: {
    titulo: "Ondas de rádio",
    texto: "São utilizadas em sistemas de comunicação, como transmissões de rádio e televisão.",
    dado: "Possuem frequências relativamente baixas e comprimentos de onda grandes.",
    escala: 12
  },
  micro: {
    titulo: "Micro-ondas",
    texto: "São utilizadas em comunicações, radares e fornos de micro-ondas.",
    dado: "Ficam entre as ondas de rádio e o infravermelho no espectro eletromagnético.",
    escala: 8
  },
  infravermelho: {
    titulo: "Infravermelho",
    texto: "Está relacionado à radiação térmica emitida pelos corpos. Sensores infravermelhos podem ajudar a medir temperaturas sem contato.",
    dado: "É importante para estudar a transferência de energia térmica.",
    escala: 5
  },
  visivel: {
    titulo: "Luz visível",
    texto: "É a faixa do espectro que nossos olhos conseguem enxergar. A luz solar pode aquecer a piscina e fornecer energia aos painéis solares.",
    dado: "A luz visível inclui as cores que percebemos no arco-íris.",
    escala: 3
  },
  ultravioleta: {
    titulo: "Ultravioleta",
    texto: "Possui frequência maior que a luz visível. Parte da radiação ultravioleta solar pode afetar a pele, tornando importante a proteção contra o Sol.",
    dado: "Seus fótons possuem mais energia que os da luz visível.",
    escala: 2
  }
};

function atualizarOnda() {
  if (!seletorOnda) return;

  const tipo = ondas[seletorOnda.value];
  if (!tipo) return;

  if (ondaTitulo) ondaTitulo.textContent = tipo.titulo;
  if (ondaTexto) ondaTexto.textContent = tipo.texto;
  if (ondaDado) ondaDado.textContent = tipo.dado;

  if (ondaVisual) {
    ondaVisual.style.backgroundSize = `${tipo.escala * 10}px 100px`;
    ondaVisual.style.animationDuration = `${tipo.escala / 2}s`;
  }
}

if (seletorOnda) {
  seletorOnda.addEventListener("change", atualizarOnda);
  atualizarOnda();
}


/* 4. SIMULADOR DE AQUECIMENTO DA PISCINA */

const sol = document.getElementById("sol");
const solValor = document.getElementById("solValor");
const absorcao = document.getElementById("absorcao");
const absValor = document.getElementById("absValor");
const capa = document.getElementById("capa");
const calcular = document.getElementById("calcular");
const temperatura = document.getElementById("temperatura");
const barraCalor = document.getElementById("barraCalor");
const resultadoCalor = document.getElementById("resultadoCalor");

function calcularTemperatura() {
  if (!sol || !absorcao || !capa) return;

  const intensidade = Number(sol.value);
  const absorcaoSolar = Number(absorcao.value);
  const temCapa = capa.checked;

  if (solValor) solValor.textContent = `${intensidade}%`;
  if (absValor) absValor.textContent = `${absorcaoSolar}%`;

  /*
    Modelo didático simplificado.
    Não prevê a temperatura real de uma piscina.
  */

  const aquecimento = intensidade * (absorcaoSolar / 100);
  const retencao = temCapa ? 1.25 : 1;
  const indice = Math.min(100, Math.round(aquecimento * retencao));

  if (temperatura) {
    temperatura.textContent = `${indice}%`;
  }

  if (barraCalor) {
    barraCalor.style.width = `${indice}%`;
    barraCalor.setAttribute("aria-valuenow", String(indice));
  }

  if (resultadoCalor) {
    let mensagem;

    if (intensidade < 25) {
      mensagem = "Com pouca luz solar, a energia disponível para aquecer a piscina é menor.";
    } else if (absorcaoSolar < 40) {
      mensagem = "Uma superfície que absorve menos energia recebe menos energia solar para aquecimento.";
    } else if (temCapa) {
      mensagem = "Neste modelo ilustrativo, a cobertura representa uma maior retenção de calor.";
    } else {
      mensagem = "A energia solar absorvida pode aquecer a água, mas parte do calor também é perdida para o ambiente.";
    }

    resultadoCalor.textContent = mensagem;
  }
}

if (calcular) {
  calcular.addEventListener("click", calcularTemperatura);
}
if (sol) sol.addEventListener("input", calcularTemperatura);
if (absorcao) absorcao.addEventListener("input", calcularTemperatura);
if (capa) capa.addEventListener("change", calcularTemperatura);

calcularTemperatura();


/* 5. EFEITO FOTOELÉTRICO E ENERGIA SOLAR */

const luz = document.getElementById("luz");
const luzValor = document.getElementById("luzValor");
const fotons = document.getElementById("fotons");
const geracao = document.getElementById("geracao");
const explicacaoPV = document.getElementById("explicacaoPV");

function atualizarEnergiaSolar() {
  if (!luz || !fotons) return;

  const intensidade = Number(luz.value);
  const frequencia = Number(fotons.value);

  if (luzValor) luzValor.textContent = `${intensidade}%`;

  if (geracao) {
    geracao.textContent =
      `Intensidade da luz: ${intensidade}% | Energia relativa por fóton: ${frequencia}`;
  }

  if (explicacaoPV) {
    if (frequencia < 3) {
      explicacaoPV.textContent =
        "No efeito fotoelétrico, se a energia de cada fóton ficar abaixo do mínimo necessário para o material, não haverá emissão de elétrons, mesmo aumentando a intensidade da luz.";
    } else {
      explicacaoPV.textContent =
        "Fótons mais energéticos podem fornecer mais energia aos elétrons. A intensidade está relacionada à quantidade de fótons incidentes. Painéis fotovoltaicos transformam luz em energia elétrica por um mecanismo relacionado, mas diferente do efeito fotoelétrico externo.";
    }
  }
}

if (luz) luz.addEventListener("input", atualizarEnergiaSolar);
if (fotons) fotons.addEventListener("input", atualizarEnergiaSolar);

atualizarEnergiaSolar();


/* 6. SENSORES DA PISCINA E ROBÓTICA */

const temperaturaSensor = document.getElementById("temperaturaSensor");
const tempSensorValor = document.getElementById("tempSensorValor");
const luzSensor = document.getElementById("luzSensor");
const luzSensorValor = document.getElementById("luzSensorValor");
const nivelSensor = document.getElementById("nivelSensor");
const nivelSensorValor = document.getElementById("nivelSensorValor");
const decisao = document.getElementById("decisao");

function atualizarSensores() {
  if (!temperaturaSensor || !luzSensor || !nivelSensor) return;

  const temp = Number(temperaturaSensor.value);
  const iluminacao = Number(luzSensor.value);
  const nivel = Number(nivelSensor.value);

  if (tempSensorValor) tempSensorValor.textContent = `${temp} °C`;
  if (luzSensorValor) luzSensorValor.textContent = `${iluminacao}%`;
  if (nivelSensorValor) nivelSensorValor.textContent = `${nivel}%`;

  if (decisao) {
    let mensagem;

    if (nivel < 25) {
      mensagem = "Atenção: o nível simulado da água está baixo. O sistema recomenda verificar a piscina.";
    } else if (temp < 20) {
      mensagem = "A água está fria no cenário simulado. O sistema pode priorizar o aquecimento, se houver equipamento adequado.";
    } else if (iluminacao < 30) {
      mensagem = "A iluminação está baixa. A geração solar pode ser reduzida neste cenário.";
    } else {
      mensagem = "Parâmetros dentro das faixas demonstrativas. O sistema pode continuar monitorando os sensores.";
    }

    decisao.textContent = mensagem;
  }
}

if (temperaturaSensor) temperaturaSensor.addEventListener("input", atualizarSensores);
if (luzSensor) luzSensor.addEventListener("input", atualizarSensores);
if (nivelSensor) nivelSensor.addEventListener("input", atualizarSensores);

atualizarSensores();


/* 7. ANO AUTOMÁTICO NO RODAPÉ */

const anoAtual = document.getElementById("anoAtual");

if (anoAtual) {
  anoAtual.textContent = new Date().getFullYear();
}


/* 8. RESPEITAR PREFERÊNCIA POR MENOS ANIMAÇÕES */

const movimentoReduzido = window.matchMedia(
  "(prefers-reduced-motion: reduce)"
);

if (movimentoReduzido.matches) {
  document.documentElement.style.scrollBehavior = "auto";
}
