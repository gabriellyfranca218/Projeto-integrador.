/* 4. SIMULADOR TÉRMICO DA PISCINA */

const sol = document.getElementById("sol");
const solValor = document.getElementById("solValor");
const absorcao = document.getElementById("absorcao");
const absValor = document.getElementById("absValor");
const capa = document.getElementById("capa");
const calcular = document.getElementById("calcular");
const temperatura = document.getElementById("temperatura");
const barraCalor = document.getElementById("barraCalor");
const resultadoCalor = document.getElementById("resultadoCalor");

const barraEntrada = document.getElementById("barraEntrada");
const barraRetida = document.getElementById("barraRetida");
const barraPerda = document.getElementById("barraPerda");

function calcularTemperatura() {
  if (!sol || !absorcao || !capa) return;

  const intensidade = Number(sol.value);
  const absorcaoSolar = Number(absorcao.value);
  const temCapa = capa.value === "com";

  // Atualiza as porcentagens imediatamente.
  if (solValor) solValor.textContent = `${intensidade}%`;
  if (absValor) absValor.textContent = `${absorcaoSolar}%`;

  // Índice didático, não é temperatura real em °C.
  const energiaRecebida = intensidade * absorcaoSolar / 100;
  const fatorRetencao = temCapa ? 1.15 : 1;
  const indice = Math.min(
    100,
    Math.round(energiaRecebida * fatorRetencao)
  );

  const perdasIlustrativas = Math.max(
    0,
    Math.min(100, 100 - indice)
  );

  if (temperatura) {
    temperatura.textContent = indice;
  }

  if (barraCalor) {
    barraCalor.style.width = `${indice}%`;
    barraCalor.setAttribute("aria-valuenow", String(indice));
  }

  if (barraEntrada) {
    barraEntrada.style.height = `${intensidade}%`;
  }

  if (barraRetida) {
    barraRetida.style.height = `${indice}%`;
  }

  if (barraPerda) {
    barraPerda.style.height = `${perdasIlustrativas}%`;
  }

  if (resultadoCalor) {
    let mensagem;

    if (intensidade === 0 || absorcaoSolar === 0) {
      mensagem =
        "Neste modelo, não há contribuição de energia solar absorvida para o aquecimento.";
    } else if (intensidade < 25) {
      mensagem =
        "A intensidade solar está baixa. A energia disponível para aquecer a água é menor.";
    } else if (temCapa) {
      mensagem =
        "A cobertura representa uma redução das perdas térmicas. O efeito real depende do tipo de capa e das condições ambientais.";
    } else if (absorcaoSolar < 40) {
      mensagem =
        "O coletor absorve uma parcela menor da energia incidente. Materiais e superfícies diferentes absorvem energia de maneiras distintas.";
    } else {
      mensagem =
        "A energia solar absorvida contribui para o aquecimento, mas a piscina também troca calor com o ambiente.";
    }

    resultadoCalor.textContent = mensagem;
  }
}

if (sol) sol.addEventListener("input", calcularTemperatura);
if (absorcao) absorcao.addEventListener("input", calcularTemperatura);
if (capa) capa.addEventListener("change", calcularTemperatura);

if (calcular) {
  calcular.addEventListener("click", calcularTemperatura);
}

calcularTemperatura();


/* 5. EFEITO FOTOELÉTRICO */

const luz = document.getElementById("luz");
const luzValor = document.getElementById("luzValor");
const fotons = document.getElementById("fotons");
const fotonsValor = document.getElementById("fotonsValor");
const geracao = document.getElementById("geracao");
const explicacaoPV = document.getElementById("explicacaoPV");
const estadoFoton = document.getElementById("estadoFoton");
const intensidadeVisual = document.getElementById("intensidadeVisual");
const barraLuz = document.getElementById("barraLuz");

function atualizarEnergiaSolar() {
  if (!luz || !fotons) return;

  const intensidade = Number(luz.value);
  const energiaFoton = Number(fotons.value);

  if (luzValor) luzValor.textContent = `${intensidade}%`;

  if (fotonsValor) {
    fotonsValor.textContent =
      `${energiaFoton.toLocaleString("pt-BR", {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1
      })} eV`;
  }

  if (intensidadeVisual) {
    intensidadeVisual.textContent = `${intensidade}%`;
  }

  if (barraLuz) {
    barraLuz.style.width = `${intensidade}%`;
  }

  // Limiar de 2,5 eV usado somente como exemplo didático.
  const limiarIlustrativo = 2.5;
  const ocorreEmissao = energiaFoton >= limiarIlustrativo;

  if (estadoFoton) {
    estadoFoton.textContent = ocorreEmissao
      ? "Energia suficiente no exemplo"
      : "Energia abaixo do limiar";
  }

  if (geracao) {
    geracao.textContent =
      `Intensidade da luz: ${intensidade}% · ` +
      `Energia por fóton: ${energiaFoton.toLocaleString("pt-BR")} eV`;
  }

  if (explicacaoPV) {
    if (!ocorreEmissao) {
      explicacaoPV.textContent =
        "Neste exemplo, a energia de cada fóton está abaixo do limiar ilustrativo. Aumentar a intensidade aumenta a quantidade de fótons, mas não a energia individual de cada um.";
    } else if (intensidade === 0) {
      explicacaoPV.textContent =
        "Sem luz incidente, não há fótons chegando ao material, mesmo que a energia por fóton selecionada seja suficiente.";
    } else {
      explicacaoPV.textContent =
        "Neste exemplo, os fótons têm energia suficiente para superar o limiar ilustrativo. A intensidade altera a quantidade de luz incidente; a frequência está relacionada à energia de cada fóton.";
    }
  }
}

if (luz) luz.addEventListener("input", atualizarEnergiaSolar);
if (fotons) fotons.addEventListener("input", atualizarEnergiaSolar);

atualizarEnergiaSolar();


/* 6. SENSORES VIRTUAIS E ROBÓTICA */

const temperaturaSensor =
  document.getElementById("temperaturaSensor");

const tempSensorValor =
  document.getElementById("tempSensorValor");

const luzSensor =
  document.getElementById("luzSensor");

const luzSensorValor =
  document.getElementById("luzSensorValor");

const nivelSensor =
  document.getElementById("nivelSensor");

const nivelSensorValor =
  document.getElementById("nivelSensorValor");

const decisao =
  document.getElementById("decisao");

function atualizarSensores() {
  if (!temperaturaSensor || !luzSensor || !nivelSensor) return;

  const temp = Number(temperaturaSensor.value);
  const iluminacao = Number(luzSensor.value);
  const nivel = Number(nivelSensor.value);

  if (tempSensorValor) {
    tempSensorValor.textContent = `${temp} °C`;
  }

  if (luzSensorValor) {
    luzSensorValor.textContent = `${iluminacao}%`;
  }

  if (nivelSensorValor) {
    nivelSensorValor.textContent = `${nivel}%`;
  }

  if (!decisao) return;

  let mensagem;

  if (nivel < 25) {
    mensagem =
      "⚠ Nível baixo: o controlador recomenda verificar a água antes de operar equipamentos.";
  } else if (temp < 20) {
    mensagem =
      "❄ Água abaixo de 20 °C: o sistema sugere avaliar a necessidade de aquecimento.";
  } else if (temp > 32) {
    mensagem =
      "♨ Água acima de 32 °C: o sistema recomenda conferir a temperatura desejada e as condições de segurança.";
  } else if (iluminacao < 30) {
    mensagem =
      "☾ Pouca luminosidade: a contribuição solar pode estar reduzida neste cenário.";
  } else {
    mensagem =
      "✓ Leituras dentro das faixas demonstrativas: o controlador continua monitorando os sensores.";
  }

  decisao.textContent = mensagem;
}

if (temperaturaSensor) {
  temperaturaSensor.addEventListener("input", atualizarSensores);
}

if (luzSensor) {
  luzSensor.addEventListener("input", atualizarSensores);
}

if (nivelSensor) {
  nivelSensor.addEventListener("input", atualizarSensores);
}

atualizarSensores();


