
"use strict";

document.addEventListener("DOMContentLoaded", () => {
  const $ = (id) => document.getElementById(id);

  // Verificação dos elementos necessários
  const obrigatorios = [
    "temperaturaCorpo", "graficoCorpoNegro",
    "frequenciaLuz", "funcaoTrabalho",
    "sol", "cobertura", "aquecimento",
    "graficoSolar", "graficoCobertura",
    "temperaturaSensor", "luzSensor", "nivelSensor",
    "quizPergunta", "opcoesQuiz", "quizProximo"
  ];

  const ausentes = obrigatorios.filter(id => !$(id));

  if (ausentes.length) {
    console.error("AquaLuz Lab: elementos ausentes:", ausentes);
    return;
  }

  // MENU
  const menuBotao = $("menuBotao");
  const menu = $("menu");

  if (menuBotao && menu) {
    menuBotao.addEventListener("click", () => {
      const aberto = menu.classList.toggle("aberto");

      menuBotao.setAttribute("aria-expanded", String(aberto));
      menuBotao.setAttribute(
        "aria-label",
        aberto ? "Fechar menu" : "Abrir menu"
      );
    });

    menu.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => {
        menu.classList.remove("aberto");
        menuBotao.setAttribute("aria-expanded", "false");
      });
    });
  }

  // FUNÇÕES AUXILIARES
  const formatar = (numero, casas = 1) =>
    numero.toLocaleString("pt-BR", {
      minimumFractionDigits: casas,
      maximumFractionDigits: casas
    });

  function configurarCanvas(canvas) {
    const retangulo = canvas.getBoundingClientRect();

    const largura = Math.max(260, Math.round(retangulo.width));
    const altura = Math.max(220, Math.round(retangulo.height));
    const escala = Math.min(window.devicePixelRatio || 1, 2);

    canvas.width = Math.round(largura * escala);
    canvas.height = Math.round(altura * escala);

    const ctx = canvas.getContext("2d");

    ctx.setTransform(escala, 0, 0, escala, 0, 0);

    return { ctx, largura, altura };
  }

  function escrever(ctx, texto, x, y, cor = "#b9c5e3", tamanho = 11) {
    ctx.fillStyle = cor;
    ctx.font = `${tamanho}px Arial`;
    ctx.fillText(texto, x, y);
  }

  function desenharGrade(ctx, largura, altura, margem) {
    const gw = largura - margem.esquerda - margem.direita;
    const gh = altura - margem.topo - margem.baixo;

    ctx.strokeStyle = "rgba(185,197,227,.16)";
    ctx.lineWidth = 1;

    for (let i = 0; i <= 4; i++) {
      const y = margem.topo + gh * i / 4;

      ctx.beginPath();
      ctx.moveTo(margem.esquerda, y);
      ctx.lineTo(largura - margem.direita, y);
      ctx.stroke();
    }

    for (let i = 0; i <= 4; i++) {
      const x = margem.esquerda + gw * i / 4;

      ctx.beginPath();
      ctx.moveTo(x, margem.topo);
      ctx.lineTo(x, altura - margem.baixo);
      ctx.stroke();
    }

    return { gw, gh };
  }

  // ==========================================
  // 1. CORPO NEGRO - LEI DE PLANCK E WIEN
  // ==========================================

  function calcularPlanck(lambdaNm, temperatura) {
    const lambda = lambdaNm * 1e-9;
    const c2 = 1.4387769e-2;
    const expoente = c2 / (lambda * temperatura);

    if (expoente > 700) return 0;

    return 1 / (
      Math.pow(lambda, 5) * Math.expm1(expoente)
    );
  }

  function desenharGraficoCorpoNegro() {
    const canvas = $("graficoCorpoNegro");
    const { ctx, largura: w, altura: h } = configurarCanvas(canvas);

    const m = {
      esquerda: 48,
      direita: 14,
      topo: 30,
      baixo: 42
    };

    const { gw, gh } = desenharGrade(ctx, w, h, m);

    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = "#0b142b";
    ctx.fillRect(0, 0, w, h);
    desenharGrade(ctx, w, h, m);

    const T = Number($("temperaturaCorpo").value);
    const pico = 2.898e6 / T;

    $("temperaturaCorpoValor").textContent = `${T} K`;
    $("temperaturaResumo").textContent = `${T} K`;
    $("picoWien").textContent = `${formatar(pico, 0)} nm`;

    escrever(ctx, "Intensidade relativa", 7, 14, "#b9c5e3", 10);
    escrever(ctx, "Comprimento de onda (nm)", w / 2 - 70, h - 8, "#b9c5e3", 10);

    [200, 400, 600, 800, 1000].forEach((v, i) => {
      escrever(ctx, String(v), m.esquerda + gw * i / 4 - 10, h - 22);
    });

    const series = [
      { temperatura: 3000, cor: "#a78bfa" },
      { temperatura: T, cor: "#56e5f2" },
      { temperatura: 5500, cor: "#7cf7c4" }
    ];

    series.forEach((serie, indice) => {
      const pontos = [];

      for (let lambda = 200; lambda <= 1000; lambda += 4) {
        pontos.push({
          lambda,
          intensidade: calcularPlanck(lambda, serie.temperatura)
        });
      }

      const maximo = Math.max(...pontos.map(p => p.intensidade)) || 1;

      ctx.beginPath();
      ctx.strokeStyle = serie.cor;
      ctx.lineWidth = indice === 1 ? 3 : 1.8;

      pontos.forEach((p, i) => {
        const x = m.esquerda + ((p.lambda - 200) / 800) * gw;
        const y = m.topo + gh * (1 - p.intensidade / maximo);

        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });

      ctx.stroke();
    });

    escrever(ctx, "3000 K", m.esquerda + 5, m.topo + 13, "#a78bfa", 10);
    escrever(ctx, `${T} K`, m.esquerda + 78, m.topo + 13, "#56e5f2", 10);
    escrever(ctx, "5500 K", m.esquerda + 145, m.topo + 13, "#7cf7c4", 10);
  }

  $("temperaturaCorpo").addEventListener("input", desenharGraficoCorpoNegro);

  // ==========================================
  // 2. EFEITO FOTOELÉTRICO
  // ==========================================

  function atualizarFotoeletrico() {
    const frequencia = Number($("frequenciaLuz").value);
    const trabalho = Number($("funcaoTrabalho").value);

    // Frequência em unidades de 10^14 Hz.
    const f = frequencia * 1e14;

    // Constante de Planck em eV.s.
    const h = 4.135667696e-15;

    const energia = h * f;
    const cinetica = Math.max(0, energia - trabalho);
    const emite = energia >= trabalho;

    $("frequenciaValor").textContent =
      `${formatar(frequencia, 1)} × 10¹⁴ Hz`;

    $("funcaoTrabalhoValor").textContent =
      `${formatar(trabalho, 1)} eV`;

    $("energiaFoton").textContent =
      `${formatar(energia, 2)} eV`;

    $("energiaCinetica").textContent =
      `${formatar(cinetica, 2)} eV`;

    $("resultadoFotoeletrico").textContent = emite
      ? "✓ Há emissão de elétrons neste modelo. A energia do fóton supera a função trabalho."
      : "Não há emissão de elétrons. A energia do fóton é insuficiente para vencer a função trabalho.";

    $("resultadoFotoeletrico").style.color =
      emite ? "#7cf7c4" : "#ffcc7a";

    $("eletronsVisual").style.opacity = emite ? "1" : ".15";
  }

  $("frequenciaLuz").addEventListener("input", atualizarFotoeletrico);
  $("funcaoTrabalho").addEventListener("input", atualizarFotoeletrico);

  // ==========================================
  // 3. SIMULADOR DA PISCINA
  // ==========================================

  const controlesPiscina = ["sol", "cobertura", "aquecimento"];

  function calcularTemperatura(sol, cobertura, aquecimento) {
    return (
      18 +
      sol * 0.10 +
      cobertura * 0.035 +
      aquecimento * 0.055
    );
  }

  function atualizarPiscina() {
    const sol = Number($("sol").value);
    const cobertura = Number($("cobertura").value);
    const aquecimento = Number($("aquecimento").value);

    $("solValor").textContent = `${sol}%`;
    $("coberturaValor").textContent = `${cobertura}%`;
    $("aquecimentoValor").textContent = `${aquecimento}%`;

    $("energiaSolar").textContent = `${sol}%`;
    $("calorConservado").textContent = `${cobertura}%`;
    $("energiaAuxiliar").textContent = `${aquecimento}%`;

    const temperatura = calcularTemperatura(
      sol,
      cobertura,
      aquecimento
    );

    $("temperaturaPiscina").textContent =
      `${formatar(temperatura, 1)} °C`;

    let mensagem;

    if (sol < 25 && aquecimento < 25) {
      mensagem = "Pouca energia disponível no modelo. O aquecimento será limitado.";
    } else if (cobertura >= 70) {
      mensagem = "Boa conservação de calor! A cobertura ajuda a diminuir as perdas.";
    } else if (sol >= 70) {
      mensagem = "A contribuição solar está elevada neste cenário.";
    } else {
      mensagem = "Experimente aumentar a cobertura ou a contribuição solar.";
    }

    $("mensagemPiscina").textContent = mensagem;

    desenharGraficoSolar();
    desenharGraficoCobertura();
  }

  controlesPiscina.forEach(id => {
    $(id).addEventListener("input", atualizarPiscina);
  });

  $("resetPiscina").addEventListener("click", () => {
    $("sol").value = 70;
    $("cobertura").value = 50;
    $("aquecimento").value = 20;
    atualizarPiscina();
  });

  // ==========================================
  // 4. GRÁFICO DE CONTRIBUIÇÃO SOLAR
  // ==========================================

  function desenharGraficoSolar() {
    const canvas = $("graficoSolar");
    const { ctx, largura: w, altura: h } = configurarCanvas(canvas);

    const m = {
      esquerda: 45,
      direita: 15,
      topo: 25,
      baixo: 42
    };

    const { gw, gh } = desenharGrade(ctx, w, h, m);

    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = "#0b142b";
    ctx.fillRect(0, 0, w, h);
    desenharGrade(ctx, w, h, m);

    escrever(ctx, "Contribuição (%)", 7, 14, "#b9c5e3", 10);
    escrever(ctx, "Intensidade solar (%)", w / 2 - 65, h - 8, "#b9c5e3", 10);

    [0, 25, 50, 75, 100].forEach((v, i) => {
      escrever(ctx, String(v), 12, m.topo + gh * (1 - i / 4) + 4);
      escrever(ctx, String(v), m.esquerda + gw * i / 4 - 8, h - 22);
    });

    ctx.beginPath();
    ctx.strokeStyle = "#a78bfa";
    ctx.lineWidth = 2.8;

    for (let x = 0; x <= 100; x += 2) {
      const px = m.esquerda + x / 100 * gw;
      const py = m.topo + (1 - x * .8 / 100) * gh;

      if (x === 0) ctx.moveTo(px, py);
      else ctx.lineTo(px, py);
    }

    ctx.stroke();

    const atual = Number($("sol").value);
    const px = m.esquerda + atual / 100 * gw;
    const py = m.topo + (1 - atual * .8 / 100) * gh;

    ctx.beginPath();
    ctx.arc(px, py, 6, 0, Math.PI * 2);
    ctx.fillStyle = "#56e5f2";
    ctx.fill();

    ctx.strokeStyle = "#56e5f2";
    ctx.lineWidth = 2;
    ctx.stroke();
  }

  // ==========================================
  // 5. GRÁFICO DE TEMPERATURA E COBERTURA
  // ==========================================

  function desenharGraficoCobertura() {
    const canvas = $("graficoCobertura");
    const { ctx, largura: w, altura: h } = configurarCanvas(canvas);

    const m = {
      esquerda: 48,
      direita: 15,
      topo: 25,
      baixo: 42
    };

    const { gw, gh } = desenharGrade(ctx, w, h, m);

    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = "#0b142b";
    ctx.fillRect(0, 0, w, h);
    desenharGrade(ctx, w, h, m);

    const sol = Number($("sol").value);
    const aquecimento = Number($("aquecimento").value);
    const coberturaAtual = Number($("cobertura").value);

    const minimo = calcularTemperatura(sol, 0, aquecimento);
    const maximo = calcularTemperatura(sol, 100, aquecimento);

    const faixaMin = 15;
    const faixaMax = 35;

    escrever(ctx, "Temperatura (°C)", 7, 14, "#b9c5e3", 10);
    escrever(ctx, "Cobertura térmica (%)", w / 2 - 75, h - 8, "#b9c5e3", 10);

    for (let i = 0; i <= 4; i++) {
      const valor = faixaMin + (faixaMax - faixaMin) * (1 - i / 4);
      escrever(ctx, formatar(valor, 0), 9, m.topo + gh * i / 4 + 4);
      escrever(ctx, String(i * 25), m.esquerda + gw * i / 4 - 7, h - 22);
    }

    function posicaoY(valor) {
      return m.topo + (1 - (valor - faixaMin) / (faixaMax - faixaMin)) * gh;
    }

    ctx.beginPath();
    ctx.strokeStyle = "#7cf7c4";
    ctx.lineWidth = 2.8;

    for (let cobertura = 0; cobertura <= 100; cobertura += 2) {
      const temp = calcularTemperatura(sol, cobertura, aquecimento);
      const x = m.esquerda + cobertura / 100 * gw;
      const y = posicaoY(temp);

      if (cobertura === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }

    ctx.stroke();

    const temperaturaAtual = calcularTemperatura(
      sol,
      coberturaAtual,
      aquecimento
    );

    const px = m.esquerda + coberturaAtual / 100 * gw;
    const py = posicaoY(temperaturaAtual);

    ctx.beginPath();
    ctx.arc(px, py, 6, 0, Math.PI * 2);
    ctx.fillStyle = "#56e5f2";
    ctx.fill();
  }

  // ==========================================
  // 6. ROBÓTICA - SENSORES E DECISÕES
  // ==========================================

  const sensores = [
    "temperaturaSensor",
    "luzSensor",
    "nivelSensor"
  ];

  function atualizarDecisao() {
    const temperatura = Number($("temperaturaSensor").value);
    const luz = Number($("luzSensor").value);
    const nivel = Number($("nivelSensor").value);

    $("temperaturaSensorValor").textContent = `${temperatura} °C`;
    $("luzSensorValor").textContent = `${luz}%`;
    $("nivelSensorValor").textContent = `${nivel}%`;

    let titulo = "Condições monitoradas";
    let decisao = "Os sensores estão enviando dados. Nenhum alerta foi identificado.";
    let status = "● Sistema ativo";
    let alerta = false;

    if (nivel < 20) {
      titulo = "Nível de água baixo";
      decisao = "O sensor identificou nível reduzido. O sistema recomenda verificar a água.";
      status = "● Atenção ao nível";
      alerta = true;
    } else if (temperatura >= 38) {
      titulo = "Temperatura elevada";
      decisao = "O sistema recomenda verificar a temperatura e avaliar o aquecimento.";
      status = "● Atenção à temperatura";
      alerta = true;
    } else if (luz < 20) {
      titulo = "Pouca luminosidade";
      decisao = "A energia solar disponível está reduzida. O sistema pode avaliar outras fontes.";
      status = "● Pouca luminosidade";
      alerta = true;
    }

    $("tituloDecisao").textContent = titulo;
    $("decisao").textContent = decisao;
    $("statusTexto").textContent = status;

    $("statusSistema").classList.toggle("alerta", alerta);

    const registro = $("logSistema");
    const linha = document.createElement("li");

    linha.textContent =
      `${temperatura} °C · luz ${luz}% · água ${nivel}%`;

    registro.prepend(linha);

    while (registro.children.length > 4) {
      registro.lastElementChild.remove();
    }
  }

  sensores.forEach(id => {
    $(id).addEventListener("input", atualizarDecisao);
  });

  // ==========================================
  // 7. QUIZ
  // ==========================================

  const perguntas = [
    {
      pergunta: "O que caracteriza um corpo negro ideal?",
      opcoes: [
        "Reflete toda a luz que recebe",
        "Absorve toda a radiação incidente",
        "Não emite energia",
        "Possui sempre temperatura zero"
      ],
      correta: 1,
      explicacao: "O corpo negro ideal absorve toda a radiação eletromagnética incidente."
    },
    {
      pergunta: "O que acontece com o pico da emissão quando a temperatura aumenta?",
      opcoes: [
        "Vai para comprimentos de onda maiores",
        "Não se altera",
        "Vai para comprimentos de onda menores",
        "Desaparece"
      ],
      correta: 2,
      explicacao: "Pela lei de Wien, o comprimento de onda do pico diminui quando a temperatura aumenta."
    },
    {
      pergunta: "Qual é a energia de um fóton relacionada diretamente a quê?",
      opcoes: [
        "Frequência",
        "Massa",
        "Volume",
        "Distância do objeto"
      ],
      correta: 0,
      explicacao: "A energia do fóton é E = h · f, sendo proporcional à frequência."
    },
    {
      pergunta: "O que é necessário para ocorrer o efeito fotoelétrico?",
      opcoes: [
        "A luz precisa ter frequência suficiente",
        "O material precisa estar congelado",
        "A luz precisa ser sempre vermelha",
        "O elétron precisa receber massa"
      ],
      correta: 0,
      explicacao: "A energia do fóton precisa alcançar ou superar a função trabalho do material."
    },
    {
      pergunta: "Qual é a função de uma cobertura térmica na piscina?",
      opcoes: [
        "Aumentar a evaporação",
        "Reduzir perdas de calor",
        "Produzir eletricidade diretamente",
        "Aumentar o volume da água"
      ],
      correta: 1,
      explicacao: "A cobertura reduz a evaporação e ajuda a conservar a energia térmica."
    },
    {
      pergunta: "Qual tecnologia transforma luz solar em eletricidade?",
      opcoes: [
        "Coletor térmico",
        "Cobertura de piscina",
        "Painel fotovoltaico",
        "Sensor de temperatura"
      ],
      correta: 2,
      explicacao: "Células fotovoltaicas convertem energia luminosa em energia elétrica."
    },
    {
      pergunta: "Qual é o papel dos sensores na robótica?",
      opcoes: [
        "Coletar informações do ambiente",
        "Substituir toda a programação",
        "Criar energia infinita",
        "Impedir qualquer erro"
      ],
      correta: 0,
      explicacao: "Sensores coletam dados que são interpretados pelo controlador para orientar ações."
    }
  ];

  let indice = 0;
  let pontos = 0;
  let respondeu = false;
  let finalizado = false;

  function mostrarPergunta() {
    respondeu = false;
    finalizado = false;

    const atual = perguntas[indice];

    $("quizContador").textContent =
      `Pergunta ${indice + 1} de ${perguntas.length}`;

    $("quizPontos").textContent = `Pontos: ${pontos}`;
    $("quizBarra").style.width =
      `${(indice / perguntas.length) * 100}%`;

    $("quizPergunta").textContent = atual.pergunta;
    $("feedbackQuiz").textContent = "";
    $("quizProximo").disabled = true;

    $("quizProximo").textContent =
      indice === perguntas.length - 1
        ? "Ver resultado →"
        : "Próxima pergunta →";

    const area = $("opcoesQuiz");
    area.replaceChildren();

    atual.opcoes.forEach((opcao, i) => {
      const botao = document.createElement("button");

      botao.type = "button";
      botao.className = "opcao";
      botao.textContent = `${String.fromCharCode(65 + i)}. ${opcao}`;

      botao.addEventListener("click", () => {
        if (respondeu || finalizado) return;

        respondeu = true;

        const botoes = area.querySelectorAll("button");

        botoes.forEach(b => {
          b.disabled = true;
        });

        if (i === atual.correta) {
          pontos++;
          botao.classList.add("certa");
          $("feedbackQuiz").textContent =
            "✓ Correto! " + atual.explicacao;
        } else {
          botao.classList.add("errada");
          botoes[atual.correta].classList.add("certa");
          $("feedbackQuiz").textContent =
            "Não foi dessa vez. " + atual.explicacao;
        }

        $("quizPontos").textContent = `Pontos: ${pontos}`;
        $("quizBarra").style.width =
          `${((indice + 1) / perguntas.length) * 100}%`;

        $("quizProximo").disabled = false;
      });

      area.appendChild(botao);
    });
  }

  function mostrarResultado() {
    finalizado = true;

    $("quizContador").textContent = "Desafio concluído!";
    $("quizPergunta").textContent =
      `Você acertou ${pontos} de ${perguntas.length} perguntas!`;

    $("quizBarra").style.width = "100%";
    $("opcoesQuiz").replaceChildren();

    if (pontos === perguntas.length) {
      $("feedbackQuiz").textContent =
        "Excelente! Você acertou todas as questões!";
    } else if (pontos >= 4) {
      $("feedbackQuiz").textContent =
        "Muito bem! Você já conhece boa parte dos conceitos.";
    } else {
      $("feedbackQuiz").textContent =
        "Continue explorando o laboratório e tente novamente.";
    }

    $("quizProximo").textContent = "Jogar novamente ↻";
    $("quizProximo").disabled = false;
  }

  $("quizProximo").addEventListener("click", () => {
    if (finalizado) {
      indice = 0;
      pontos = 0;
      mostrarPergunta();
      return;
    }

    if (!respondeu) return;

    if (indice === perguntas.length - 1) {
      mostrarResultado();
      return;
    }

    indice++;
    mostrarPergunta();
  });

  // ==========================================
  // 8. INICIALIZAÇÃO GERAL
  // ==========================================

  atualizarPiscina();
  atualizarFotoeletrico();
  atualizarDecisao();

  mostrarPergunta();

  desenharGraficoCorpoNegro();
  desenharGraficoSolar();
  desenharGraficoCobertura();

  // Redesenha os gráficos quando a tela muda.
  let temporizador;

  window.addEventListener("resize", () => {
    clearTimeout(temporizador);

    temporizador = setTimeout(() => {
      desenharGraficoCorpoNegro();
      desenharGraficoSolar();
      desenharGraficoCobertura();
    }, 180);
  });

  console.log("AquaLuz Lab: todos os módulos foram inicializados.");
});
